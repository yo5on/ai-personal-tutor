# Google Gemini API key (server-side only). Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: Gemini model to use (default: gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# Optional: ordered backup models, tried when the main model is busy, over quota or slow.
# Comma-separated. Leave empty to use only GEMINI_MODEL.
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.5-flash-lite

# Optional: folder for the SQLite database file (default: ./data/db, or /tmp on Vercel)
# DATABASE_DIR=
